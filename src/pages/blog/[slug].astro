---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEmbedInfo, platformLabel } from '../../utils/embed';
import { sortByManualOrder } from '../../utils/sortContent';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.id.startsWith('_template'))
    // Shorts don't get their own page — they open in a modal on /#blog
    .filter((p) => p.data.type !== 'short');

  sortByManualOrder(posts);

  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prev: index > 0 ? posts[index - 1] : null,
      next: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const info = getEmbedInfo(post.data.url ?? null);
const folder = post.id.split('/')[0];
const heroImage = post.data.thumbnail ? `/blog/${folder}/${post.data.thumbnail}` : '';

const formatDate = (iso: string) => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const p = (n: number) => String(n).padStart(2, '0');
  return `${p(d.getDate())}.${p(d.getMonth() + 1)}.${d.getFullYear()}`;
};

const readMinutes = (body?: string) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));
const minutes = readMinutes(post.body);
---

<BaseLayout title={`${post.data.title} — Cenix`} description={post.data.excerpt ?? undefined} activeNav="blog">
  <main class="project-page blog-detail">
    <!-- Header -->
    <header class="project-header">
      <div class="container">
        <a href="/#blog" class="project-back">
          <span class="project-back-arrow" aria-hidden="true">←</span>
          Back to Blog
        </a>

        <span class="project-category">
          {post.data.category ?? (post.data.type === 'vlog' ? 'V-Log' : 'Article')}
        </span>

        <h1 class="project-title">{post.data.title}</h1>

        <div class="blog-meta-line">
          <span class="blog-meta-ava" aria-hidden="true"></span>
          <span>{formatDate(post.data.date)}</span>
          <span class="dot">·</span>
          <span>{minutes} phút đọc</span>
          {info.platform !== 'unknown' && (
            <>
              <span class="dot">·</span>
              <span>{platformLabel(info.platform)}</span>
            </>
          )}
        </div>

        {post.data.excerpt && <p class="project-subtitle">{post.data.excerpt}</p>}
      </div>
    </header>

    <!-- V-LOG: YouTube embed up top -->
    {post.data.type === 'vlog' && info.embedUrl && (
      <section class="project-body">
        <div class="container">
          <div class="vlog-embed">
            <iframe
              src={info.embedUrl}
              title={post.data.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              frameborder="0"
            ></iframe>
          </div>
        </div>
      </section>
    )}

    <!-- BODY: markdown content (article description / vlog description) -->
    <section class="project-body">
      <div class="container">
        {heroImage && post.data.type === 'article' && (
          <figure class="blog-detail-hero-fig">
            <img src={heroImage} alt={post.data.title} class="blog-detail-hero" />
          </figure>
        )}
        <div class="prose magazine-prose">
          <Content />
        </div>
      </div>
    </section>

    <!-- Prev / Next -->
    <nav class="project-nav" aria-label="Post navigation">
      <div class="container">
        <div class="project-nav-inner">
          {prev ? (
            <a href={`/blog/${prev.data.slug}/`} class="project-nav-prev">
              <span class="project-nav-label">← Previous</span>
              <span class="project-nav-title">{prev.data.title}</span>
            </a>
          ) : (
            <a href="/#blog" class="project-nav-prev">
              <span class="project-nav-label">← All posts</span>
              <span class="project-nav-title">Blog</span>
            </a>
          )}
          {next ? (
            <a href={`/blog/${next.data.slug}/`} class="project-nav-next" style="text-align: right;">
              <span class="project-nav-label">Next →</span>
              <span class="project-nav-title">{next.data.title}</span>
            </a>
          ) : (
            <a href="/#blog" class="project-nav-next" style="text-align: right;">
              <span class="project-nav-label">All posts →</span>
              <span class="project-nav-title">Blog</span>
            </a>
          )}
        </div>
      </div>
    </nav>
  </main>
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     BLOG DETAIL — magazine reading layer (light / cream surface)
     Ported from the Cenix Gaming News detail, adapted to imcenix.
     Structure only; palette stays on the existing cream body.
     ───────────────────────────────────────────────────────────── */

  /* Hero image as a framed figure that can carry a caption */
  .blog-detail .blog-detail-hero-fig {
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    max-width: 1000px;
  }
  .blog-detail :global(.blog-detail-hero) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .18);
  }

  /* Compact meta line under the title (date · read · source) ------ */
  .blog-detail .blog-meta-line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 1.15rem;
    font-family: var(--font-body);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .58);
  }
  .blog-detail .blog-meta-ava {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: repeating-linear-gradient(45deg, #1c1c22 0, #1c1c22 6px, #242430 6px, #242430 12px);
  }
  .blog-detail .blog-meta-line .dot { opacity: .5; }

  /* Reading column ------------------------------------------------ */
  .blog-detail :global(.magazine-prose) {
    max-width: 720px;
    margin: 0 auto;
    color: #26221c;
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.15vw, 1.25rem);
    font-weight: 400;
    line-height: 1.85;
    text-wrap: pretty;
  }

  /* Small lime rule that opens the article body */
  .blog-detail :global(.magazine-prose)::before {
    content: '';
    display: block;
    width: 64px;
    height: 3px;
    margin: 0 0 2.4rem;
    background: var(--color-lime);
  }

  .blog-detail :global(.magazine-prose > p) { margin: 0 0 1.5em; }

  /* Drop cap — first letter spans ~3 lines (body stays normal size) */
  .blog-detail :global(.magazine-prose > p:first-of-type::first-letter) {
    float: left;
    margin: .06em .12em 0 0;
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-size: 4.7em;
    font-weight: 700;
    line-height: .72;
  }

  /* Section headings ---------------------------------------------- */
  .blog-detail :global(.magazine-prose h1),
  .blog-detail :global(.magazine-prose h2) {
    position: relative;
    max-width: none;
    margin: 2.4em 0 .7em;
    padding-top: 1.1rem;
    color: #14110d;
    font-family: var(--font-heading-vn);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
  }
  .blog-detail :global(.magazine-prose h1) { font-size: clamp(2rem, 3.4vw, 2.9rem); }
  .blog-detail :global(.magazine-prose h2) { font-size: clamp(1.6rem, 2.6vw, 2.25rem); }
  .blog-detail :global(.magazine-prose h1::before),
  .blog-detail :global(.magazine-prose h2::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--color-lime);
  }
  .blog-detail :global(.magazine-prose h3) {
    max-width: none;
    margin: 1.9em 0 .5em;
    color: #14110d;
    font-family: var(--font-heading-vn);
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .blog-detail :global(.magazine-prose strong) { color: #14110d; font-weight: 700; }
  .blog-detail :global(.magazine-prose a) {
    color: #14110d;
    border-bottom: 1px solid var(--color-blue);
    text-decoration: none;
  }
  .blog-detail :global(.magazine-prose a:hover) { border-bottom-color: var(--color-lime); }

  /* Lists --------------------------------------------------------- */
  .blog-detail :global(.magazine-prose ul),
  .blog-detail :global(.magazine-prose ol) {
    max-width: none;
    margin: 0 0 1.5em;
    padding-left: 1.3em;
  }
  .blog-detail :global(.magazine-prose li) { margin: .4em 0; padding-left: .2em; }
  .blog-detail :global(.magazine-prose li::marker) { color: var(--color-blue); }

  /* Horizontal rule (`* * *`) as a centred editorial divider ------ */
  .blog-detail :global(.magazine-prose hr) {
    width: 60px;
    height: 0;
    margin: 3rem auto;
    border: 0;
    border-top: 2px solid rgba(20, 17, 13, .18);
  }

  /* Figures & captions ("Hình ảnh có thêm description") ----------- */
  .blog-detail :global(.magazine-prose figure.editorial-figure) {
    width: 100%;
    margin: 2.6rem 0;
  }
  .blog-detail :global(.magazine-prose figure.editorial-figure img) {
    width: 100%;
    margin: 0;
    display: block;
    border-radius: 3px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, .18);
  }
  .blog-detail :global(.magazine-prose figure.editorial-figure figcaption) {
    margin-top: .85rem;
    padding-left: 14px;
    border-left: 2px solid var(--color-lime);
    color: #6a6357;
    font-family: var(--font-serif);
    font-size: .92rem;
    font-style: italic;
    line-height: 1.5;
  }

  /* Two-column body block ("chia cột cho đẹp") -------------------- */
  .blog-detail :global(.magazine-prose .editorial-columns) {
    max-width: none;
    margin: 2.4rem 0;
    column-count: 2;
    column-gap: clamp(1.5rem, 3vw, 2.75rem);
    column-rule: 1px solid rgba(20, 17, 13, .12);
  }
  .blog-detail :global(.magazine-prose .editorial-columns > *) { break-inside: avoid; }
  .blog-detail :global(.magazine-prose .editorial-columns > :first-child) { margin-top: 0; }

  /* Inline images without an explicit caption stay clean & framed */
  .blog-detail :global(.magazine-prose > p:has(> img:only-child)) {
    max-width: none;
    margin: 3rem 0;
  }
  .blog-detail :global(.magazine-prose > p > img) {
    border-radius: 3px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, .18);
  }

  @media (max-width: 760px) {
    .blog-detail :global(.magazine-prose) { font-size: 1.08rem; line-height: 1.8; }
    .blog-detail :global(.magazine-prose > p:first-of-type::first-letter) { font-size: 4.1em; }
    .blog-detail :global(.magazine-prose figure.editorial-figure) { width: 100%; margin: 2.4rem 0; }
    .blog-detail :global(.magazine-prose .editorial-columns) { column-count: 1; }
  }
</style>
