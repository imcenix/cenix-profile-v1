---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByManualOrder } from '../../utils/sortContent';

const posts = (await getCollection('blog')).filter(
  (p) => !p.id.startsWith('_template') && p.data.type === 'article'
);
sortByManualOrder(posts);

const readMinutes = (body?: string) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const toCard = (post: (typeof posts)[number]) => {
  const folder = post.id.split('/')[0];
  return {
    ...post.data,
    thumbnailUrl: post.data.thumbnail ? `/blog/${folder}/${post.data.thumbnail}` : '',
    detailUrl: `/blog/${post.data.slug}/`,
    minutes: readMinutes(post.body),
  };
};

const cards = posts.map(toCard);
// Lead story: first pinned/featured post, else the newest by manual order.
const featuredIndex = Math.max(0, cards.findIndex((c) => c.featured));
const featured = cards[featuredIndex];
const rest = cards.filter((_, i) => i !== featuredIndex);
const highlights = rest.slice(0, 2);
const more = rest.slice(2);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Articles — Cenix" activeNav="blog">
  <main class="project-page blog-listing">
    <header class="project-header">
      <div class="container">
        <a href="/" class="project-back">
          <span class="project-back-arrow" aria-hidden="true">←</span> Back to Home
        </a>
        <span class="project-category">Blog</span>
        <h1 class="project-title">Articles</h1>
        <p class="project-subtitle">
          Long-form thinking, technology notes, and case study writeups on brand,
          design, and creative direction.
        </p>
      </div>
    </header>

    <section class="project-body">
      <div class="container">
        {cards.length === 0 ? (
          <div class="section-placeholder"><span class="placeholder-tag">No articles yet</span></div>
        ) : (
          <div class="news-wrap">
            <!-- Lead story -->
            <a class="news-feature" href={featured.detailUrl}>
              <div class="news-feature-media">
                {featured.thumbnailUrl ? (
                  <img src={featured.thumbnailUrl} alt={featured.title} loading="eager" />
                ) : (
                  <div class="news-ph" aria-hidden="true"><span>Article</span></div>
                )}
              </div>
              <div class="news-feature-body">
                <div class="news-feature-tags">
                  <span class="news-badge">Featured</span>
                  <span class="news-meta">{formatDate(featured.date)} · {featured.minutes} min read</span>
                </div>
                <h2 class="news-feature-title">{featured.title}</h2>
                {featured.excerpt && <p class="news-feature-dek">{featured.excerpt}</p>}
                <span class="news-readlink">Read article →</span>
              </div>
            </a>

            <!-- Highlights (điểm nhấn) -->
            {highlights.length > 0 && (
              <div class="news-block">
                <h3 class="news-section-label"><span class="news-section-mark" aria-hidden="true">✦</span> Highlights</h3>
                <div class="news-highlight-grid">
                  {highlights.map((card) => (
                    <a class="news-highlight" href={card.detailUrl}>
                      <div class="news-highlight-media">
                        {card.thumbnailUrl ? (
                          <img src={card.thumbnailUrl} alt={card.title} loading="lazy" />
                        ) : (
                          <div class="news-ph" aria-hidden="true"><span>Article</span></div>
                        )}
                      </div>
                      <span class="news-meta">{card.category ?? 'Article'} · {formatDate(card.date)}</span>
                      <h4 class="news-highlight-title">{card.title}</h4>
                      {card.excerpt && <p class="news-highlight-dek">{card.excerpt}</p>}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- More / related articles -->
            {more.length > 0 && (
              <div class="news-block">
                <h3 class="news-section-label"><span class="news-section-mark" aria-hidden="true">✦</span> More articles</h3>
                <div class="news-list">
                  {more.map((card) => (
                    <a class="news-row" href={card.detailUrl}>
                      <div class="news-row-media">
                        {card.thumbnailUrl ? (
                          <img src={card.thumbnailUrl} alt={card.title} loading="lazy" />
                        ) : (
                          <div class="news-ph" aria-hidden="true"><span>Article</span></div>
                        )}
                      </div>
                      <div class="news-row-body">
                        <span class="news-meta">{card.category ?? 'Article'} · {formatDate(card.date)} · {card.minutes} min</span>
                        <h4 class="news-row-title">{card.title}</h4>
                        {card.excerpt && <p class="news-row-dek">{card.excerpt}</p>}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     BLOG LISTING — News layout (lead story + highlights + list)
     Cream body, white cards, lime accent. Structure ported from the
     Cenix Gaming News listing.
     ───────────────────────────────────────────────────────────── */
  .blog-listing .news-wrap { max-width: 1120px; margin: 0 auto; }

  .news-badge {
    display: inline-flex;
    padding: .3rem .7rem;
    background: var(--color-lime);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .news-meta {
    font-family: var(--font-body);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .01em;
    color: #6a6357;
  }

  /* Lead story ---------------------------------------------------- */
  .news-feature {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
    color: inherit;
  }
  .news-feature-media {
    min-width: 0;
    overflow: hidden;
    border-radius: 6px;
    background: #e7e4da;
    aspect-ratio: 16 / 10;
  }
  .news-feature-media img,
  .news-highlight-media img,
  .news-row-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .6s cubic-bezier(.2, .8, .2, 1);
  }
  .news-feature:hover .news-feature-media img,
  .news-highlight:hover .news-highlight-media img,
  .news-row:hover .news-row-media img { transform: scale(1.04); }

  .news-feature-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .9rem;
  }
  .news-feature-tags { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .news-feature-title {
    font-family: var(--font-heading-vn);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.3vw, 2.1rem);
    line-height: 1.16;
    letter-spacing: 0;
    color: #14110d;
    text-wrap: balance;
  }
  .news-feature:hover .news-feature-title { color: var(--color-blue); }
  .news-feature-dek {
    max-width: 46ch;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #4a443b;
  }
  .news-readlink {
    font-family: var(--font-body);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  /* Section label ------------------------------------------------- */
  .news-block { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .news-section-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #14110d;
  }
  .news-section-mark { color: var(--color-lime); }

  /* Highlights grid ----------------------------------------------- */
  .news-highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .news-highlight { display: flex; flex-direction: column; gap: .7rem; color: inherit; }
  .news-highlight-media {
    overflow: hidden;
    border-radius: 6px;
    background: #e7e4da;
    aspect-ratio: 16 / 9;
    margin-bottom: .3rem;
  }
  .news-highlight-title {
    font-family: var(--font-heading-vn);
    font-weight: 700;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.18;
    color: #14110d;
  }
  .news-highlight:hover .news-highlight-title { color: var(--color-blue); }
  .news-highlight-dek {
    font-family: var(--font-serif);
    font-size: .96rem;
    line-height: 1.55;
    color: #4a443b;
  }

  /* More list ----------------------------------------------------- */
  .news-list { display: flex; flex-direction: column; }
  .news-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    padding: 1.6rem 0;
    border-top: 1px solid rgba(20, 17, 13, .1);
    color: inherit;
  }
  .news-row:first-child { border-top: 0; }
  .news-row-media {
    overflow: hidden;
    border-radius: 5px;
    background: #e7e4da;
    aspect-ratio: 16 / 10;
  }
  .news-row-body { display: flex; flex-direction: column; justify-content: center; gap: .5rem; }
  .news-row-title {
    font-family: var(--font-heading-vn);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.2;
    color: #14110d;
  }
  .news-row:hover .news-row-title { color: var(--color-blue); }
  .news-row-dek {
    max-width: 62ch;
    font-family: var(--font-serif);
    font-size: .95rem;
    line-height: 1.55;
    color: #4a443b;
  }

  .news-ph {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(45deg, #e7e4da 0 10px, #e0ddd2 10px 20px);
    color: #9a9284;
    font-family: var(--font-body);
    font-size: .7rem;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .news-feature { grid-template-columns: 1fr; }
    .news-feature-media { aspect-ratio: 16 / 9; }
    .news-highlight-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .news-row { grid-template-columns: 1fr; }
    .news-row-media { aspect-ratio: 16 / 9; }
  }
</style>
