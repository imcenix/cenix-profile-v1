---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByManualOrder } from '../../utils/sortContent';
const posts=(await getCollection('blog')).filter((p)=>!p.id.startsWith('_template')&&p.data.type==='article');
sortByManualOrder(posts);
const cards=posts.map((post)=>{const folder=post.id.split('/')[0];return {...post.data,thumbnailUrl:post.data.thumbnail?`/blog/${folder}/${post.data.thumbnail}`:'',detailUrl:`/blog/${post.data.slug}/`};});
const formatDate=(iso:string)=>new Date(iso).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});
---
<BaseLayout title="Articles — Cenix" activeNav="blog">
<main class="project-page blog-listing">
  <header class="project-header"><div class="container"><a href="/" class="project-back"><span class="project-back-arrow" aria-hidden="true">←</span> Back to Home</a><span class="project-category">Blog</span><h1 class="project-title">Articles</h1><p class="project-subtitle">Long-form thinking, technology notes, and case study writeups on brand, design, and creative direction.</p></div></header>
  <section class="project-body"><div class="container">
    <div class="blog-filters"><span class="blog-filter is-active">Articles <span class="blog-filter-count">{cards.length}</span></span></div>
    {cards.length===0?<div class="section-placeholder"><span class="placeholder-tag">No articles yet</span></div>:<div class="blog-grid blog-grid--listing">{cards.map((card)=><a class="blog-card blog-card--wide" href={card.detailUrl}><div class="blog-card-media">{card.thumbnailUrl?<img src={card.thumbnailUrl} alt={card.title} loading="lazy"/>:<div class="blog-card-placeholder" aria-hidden="true"><span>Article</span></div>}</div><div class="blog-card-content"><span class="blog-card-meta">{card.category??'Article'} · {formatDate(card.date)}</span><h3 class="blog-card-title">{card.title}</h3>{card.excerpt&&<p class="blog-card-excerpt">{card.excerpt}</p>}</div></a>)}</div>}
  </div></section>
</main>
</BaseLayout>